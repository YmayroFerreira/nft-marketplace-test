# Public configuration (no secrets). Overridden by .env.local, which is not committed.

# Starts the MSW mock API (REST + Socket.IO) before the app. Also on in the demo build.
VITE_ENABLE_MOCKS=true

# Base URL of the REST API.
VITE_API_URL=/api

# URL of the Socket.IO server. Empty means the same origin as the app.
VITE_SOCKET_URL=
